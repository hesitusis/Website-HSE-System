# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SERVICE_ACCOUNT_JSON: The Google Cloud Service Account credentials JSON string.
# Required for connecting and synchronizing with Google Sheets and Google Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=

# GOOGLE_SPREADSHEET_ID: The Google Spreadsheet ID to sync main HSE reports.
GOOGLE_SPREADSHEET_ID="17R9i0n3eMOOSGO3wF_8MJKJ5oqsjW-aQ6gUMMHNjbNY"

# GOOGLE_SPREADSHEET_DAILY_ID: The Google Spreadsheet ID for Daily Report sync.
GOOGLE_SPREADSHEET_DAILY_ID="19kUpCQRjaMzZo1KMtXklhlRIOx7eMsyiRtpMCHzAvZo"

# GOOGLE_SPREADSHEET_SPIP_ID: The Google Spreadsheet ID for SPIP Safety Monitoring.
GOOGLE_SPREADSHEET_SPIP_ID="1xCY6lXcwWpsZy_Wm2qNrwtDB0iw7Wp0RvB4H_kuG_TA"

# GOOGLE_DRIVE_FOLDER_ID: The Google Drive Folder ID to upload documents & photos.
GOOGLE_DRIVE_FOLDER_ID="1x5Duwji-8B7Xq0hvCoOj7NxtlLcZXpIB"

# SMTP E-mail configurations for approval notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GOOGLE_APPS_SCRIPT_URL: Google Apps Script Web App URL to bypass Service Account storage quota limit.
# Set this to your deployed Apps Script URL if you are using a personal Gmail Google Drive (My Drive).
# The Apps Script acts as a proxy, writing files directly into your personal folder using your own quota.
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycby6kmuh_7-jZFc2xpJv1TYvfVcqB48KwECMJFUhaVLD8xRjQJ4qSRMiJQO_LnwmymOoEQ/exec"

